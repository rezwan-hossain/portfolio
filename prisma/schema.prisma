generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String        @id @default(uuid())
  authId              String        @unique
  email               String        @unique
  firstName           String?
  lastName            String?
  userName            String?       @unique
  phone               String?
  address             String?
  birthDate           DateTime?
  gender              String?
  image               String?
  role                Role          @default(USER)
  forcePasswordChange Boolean       @default(false)
  isActive            Boolean       @default(true)
  isArchived          Boolean       @default(false)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  isGuest             Boolean       @default(false)
  couponUsages        CouponUsage[]
  orders              Order[]

  @@map("users")
}

model Organizer {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  logo      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events    Event[]

  @@map("organizers")
}

model Event {
  id              String         @id @default(uuid())
  name            String
  slug            String         @unique
  date            DateTime
  time            DateTime
  address         String
  eventType       EventType      @default(LIVE)
  organizerId     Int
  description     String
  shortDesc       String?        @db.VarChar(255)
  bannerImage     String
  thumbImage      String?
  minPackagePrice Float?
  // Custom payment-confirmation SMS for this event; null = use the default
  // (site_settings "sms.confirmation"). See lib/sms-template.ts.
  confirmationSmsTemplate String?
  status          Status         @default(ACTIVE)
  isActive        Boolean        @default(true)
  isArchived      Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  coupons         Coupon[]
  organizer       Organizer      @relation(fields: [organizerId], references: [id])
  orders          Order[]
  packages        Package[]
  registrations   Registration[]

  @@map("events")
}

model Package {
  id             Int      @id @default(autoincrement())
  name           String
  distance       String
  price          Int
  availableSlots Int
  usedSlots      Int      @default(0)
  status         Status   @default(ACTIVE)
  isActive       Boolean  @default(true)
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  eventId        String
  orders         Order[]
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  coupons        Coupon[] @relation("CouponToPackages")

  @@map("packages")
}

model Order {
  id           String        @id @default(uuid())
  status       OrderStatus   @default(PENDING)
  isActive     Boolean       @default(true)
  isArchived   Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  qty          Int           @default(1)
  subtotal     Float         @default(0)
  discount     Float         @default(0)
  total        Float         @default(0)
  userId       String
  packageId    Int
  eventId      String
  couponId     String?

  source       OrderSource   @default(ONLINE)  // ONLINE = normal checkout, MANUAL = admin entered
  createdById  String?                          // which admin created it (User.id)
  adminNote    String?                          // "cash at booth", "sponsor comp", etc.

  // Marketing channel that brought this buyer (last non-direct visit within 30
  // days, see lib/traffic-source.ts). Null = not tracked (older / manual orders).
  trafficSource   String?
  trafficCampaign String?

  // Online checkouts hold a slot until this time. Non-null = the system owns the
  // hold (it can release it, and the order can be reclaimed on retry). Null =
  // never auto-released (manual orders, admin-set statuses, manual review).
  holdExpiresAt DateTime?


  couponUsage  CouponUsage?
  coupon       Coupon?       @relation(fields: [couponId], references: [id])
  event        Event         @relation(fields: [eventId], references: [id])
  package      Package       @relation(fields: [packageId], references: [id])
  // Restrict: orders and payments are financial records — a user who has any
  // can't be hard-deleted (users are soft-deleted via isArchived instead).
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  payment      Payment?
  registration Registration?

  @@index([eventId, createdAt])   // default sort: newest first, per event
  @@index([eventId, status])      // status filter and the stats groupBy
  @@index([status, holdExpiresAt]) // expired-hold sweep

  @@map("orders")
}

model Registration {
  id                     String   @id @default(uuid())
  orderId                String   @unique
  eventId                String
  bibNumber              String?
  fullName               String
  phone                  String
  gender                 String
  birthDate              DateTime
  ageCategory            String
  bloodGroup             String
  tshirtSize             String
  emergencyContactName   String?
  emergencyContactNumber String?
  communityName          String?
  runnerCategory         String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  email                  String?
  event                  Event    @relation(fields: [eventId], references: [id])
  order                  Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([eventId, bibNumber])
  @@map("registrations")
}

model Payment {
  id             String        @id @default(uuid())
  amount         Int
  currency       String        @default("BDT")
  status         PaymentStatus @default(PENDING)
  transactionId  String?       @unique
  paymentId      String?       @unique
  paymentMethod  String?
  paymentGateway String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  orderId        String        @unique
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@map("payments")
}

model HeroSection {
  id             String    @id @default(uuid())
  title          String    @default("Run Beyond")
  desktopImage   String
  mobileImage    String?
  slug           String?
  eventDate      DateTime?
  showCountdown  Boolean   @default(true)
  countdownColor String    @default("#374151")
  showSlugButton Boolean   @default(true)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("hero_sections")
}

model GalleryImage {
  id        String   @id @default(cuid())
  src       String
  alt       String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("gallery_images")
}

model Coupon {
  id             String        @id @default(uuid())
  code           String
  discountType   DiscountType  @default(PERCENTAGE)
  discountValue  Float
  maxUses        Int?
  usedCount      Int           @default(0)
  maxUsesPerUser Int           @default(1)
  minOrderAmount Float?
  maxDiscount    Float?
  validFrom      DateTime
  validUntil     DateTime
  isActive       Boolean       @default(true)
  // "Deleted" coupons that orders used: hidden and unusable, kept for history.
  isArchived     Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  eventId        String
  scopeType      CouponScope   @default(EVENT)
  usages         CouponUsage[]
  event          Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orders         Order[]
  packages       Package[]     @relation("CouponToPackages")

  @@unique([code, eventId])
  @@map("coupons")
}

model CouponUsage {
  id       String   @id @default(uuid())
  discount Float
  usedAt   DateTime @default(now())
  couponId String
  userId   String
  orderId  String   @unique
  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([couponId, orderId])
  @@map("coupon_usages")
}

model TeamMember {
  id           String       @id @default(uuid())
  name         String
  role         String?
  bio          String?
  image        String?
  sortOrder    Int          @default(0)
  category     TeamCategory @default(ADVISOR)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  linkedinUrl  String?
  twitterUrl   String?
  githubUrl    String?
  instagramUrl String?
  facebookUrl  String?

  @@map("team_members")
}

enum Role {
  USER
  ADMIN
  ORGANIZER
}

enum EventType {
  LIVE
  VIRTUAL
}

enum Status {
  ACTIVE
  INACTIVE
  CANCELLED
  COMPLETED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CouponScope {
  EVENT
  PACKAGE
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum TeamCategory {
  ADMIN
  ADVISOR
  ORGANIZER
}

enum OrderSource {
  ONLINE
  MANUAL
}
// Append-only audit trail: who changed what, when. No foreign keys on purpose —
// entries must survive deletion of the event/order/user they describe.
// Written through lib/audit.ts; read in the admin "Audit Log" tab.
model AuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  actorId    String? // User.id of the admin/customer; null for system actors
  actorLabel String // email, or e.g. "System · ShurjoPay"
  action     String // e.g. "event.updated", "order.status_changed"
  entityType String // event | package | order | registration | payment | coupon | hero | gallery | team | organizer
  entityId   String
  eventId    String? // for filtering by event
  summary    String // one human-readable line
  changes    Json? // { field: [before, after] }
  requestId  String? // ties the entry to the Axiom request logs

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([eventId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// Small key/value store for admin-editable site settings
// (e.g. "sms.confirmation" = the default confirmation SMS template).
model SiteSetting {
  key         String   @id
  value       String
  updatedAt   DateTime @updatedAt
  updatedById String? // User.id of the admin who last changed it

  @@map("site_settings")
}

// Homepage FAQ, edited under Manage Homepage. Seeded with the original
// questions by the faqs migration.
model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("faqs")
}

// Built-in page-view counter (see lib/page-views.ts). Counts only — no IPs,
// no personal data. `path` is a normalised page key ("/", "/events/<slug>",
// "other", or "*" for the whole site).
model PageViewDaily {
  day     String // YYYY-MM-DD, Asia/Dhaka
  path    String
  eventId String? // set for /events/<slug> pages
  views   Int     @default(0)
  uniques Int     @default(0)

  @@id([day, path])
  @@index([eventId, day])
  @@map("page_view_daily")
}

// Short-lived: one anonymous hash per visitor, page and day, only to count
// unique visitors and ignore rapid refreshes. Rows older than 2 days are
// deleted by the hourly sweep.
model PageVisitor {
  day      String
  path     String
  hash     String
  lastSeen DateTime @default(now())

  @@id([day, path, hash])
  @@index([day])
  @@map("page_visitors")
}

// Visits per marketing channel per day (landing pages only, bots excluded).
model TrafficSourceDaily {
  day      String // YYYY-MM-DD, Asia/Dhaka
  source   String // "Facebook", "Google", "Direct", …
  campaign String @default("") // utm_campaign (sanitised), "" when none
  visits   Int    @default(0)

  @@id([day, source, campaign])
  @@map("traffic_source_daily")
}

// Share-button clicks per event, place and channel per day (see lib/share.ts).
// Counts only. `sharers` = distinct people that day (same anonymous daily hash
// as the page-view counter).
model ShareClickDaily {
  day     String // YYYY-MM-DD, Asia/Dhaka
  eventId String
  place   String // "event" (event page) | "paid" (after paying)
  channel String // "whatsapp" | "facebook" | "messenger" | "x" | "copy" | "native"
  clicks  Int    @default(0)
  sharers Int    @default(0)

  @@id([day, eventId, place, channel])
  @@index([eventId, day])
  @@map("share_click_daily")
}
